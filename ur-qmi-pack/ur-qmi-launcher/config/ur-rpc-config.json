{
  "client_id": "ur-qmi-launcher",
  "broker_host": "127.0.0.1",
  "broker_port": 1899,
  "keepalive": 60,
  "qos": 1,
  "auto_reconnect": true,
  "reconnect_delay_min": 1,
  "reconnect_delay_max": 60,
  "use_tls": false,
  "heartbeat": {
    "enabled": true,
    "interval_seconds": 5,
    "topic": "clients/ur-qmi-launcher/heartbeat",
    "payload": "{\"client\":\"ur-qmi-launcher\",\"status\":\"alive\"}"
  },
  "json_added_pubs": {
    "topics": [
      "direct_messaging/ur-qmi-launcher/responses",
      "direct_messaging/ur-qmi-ident/requests"
    ]
  },
  "json_added_subs": {
    "topics": [
      "direct_messaging/ur-qmi-launcher/requests",
      "direct_messaging/ur-qmi-ident/responses",
      "clients/ur-qmi-ident/heartbeat"
    ]
  }
}
