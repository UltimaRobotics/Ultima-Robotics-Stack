{
  "client_id": "ur-network-collector",
  "broker_host": "127.0.0.1",
  "broker_port": 1899,
  "keepalive": 60,
  "qos": 0,
  "auto_reconnect": true,
  "reconnect_delay_min": 1,
  "reconnect_delay_max": 60,
  "use_tls": false,
  "heartbeat": {
    "enabled": true,
    "interval_seconds": 1,
    "topic": "clients/ur-network-collector/heartbeat",
    "payload": "{\"client\":\"ur-network-collector\",\"status\":\"alive\"}"
  },
  "json_added_pubs": {
    "topics": [
      "direct_messaging/ur-network-collector/responses",
      "ur-shared-bus/ur-network-stack/ur-net-collector/runtime-vlan",
      "ur-shared-bus/ur-network-stack/ur-net-collector/runtime-nat",
      "ur-shared-bus/ur-network-stack/ur-net-collector/runtime-firewall",
      "ur-shared-bus/ur-network-stack/ur-net-collector/runtime-routes",
      "ur-shared-bus/ur-network-stack/ur-net-collector/runtime-bridges"
    ]
  },
  "json_added_subs": {
    "topics": [
      "direct_messaging/ur-network-collector/requests"
    ]
  }
}
