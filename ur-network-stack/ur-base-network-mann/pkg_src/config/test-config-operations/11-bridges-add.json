{
  "description": "Add network bridges",
  "bridges": [
    {
      "operation": "add",
      "name": "lan-bridge",
      "interfaces": ["eth0", "eth1", "eth2"],
      "stp": "on",
      "forward_delay": "15",
      "max_age": "20",
      "hello_time": "2",
      "enabled": true
    },
    {
      "operation": "add",
      "name": "guest-bridge",
      "interfaces": ["eth3", "eth4"],
      "stp": "off",
      "forward_delay": "15",
      "max_age": "20",
      "hello_time": "2",
      "enabled": true
    },
    {
      "operation": "add",
      "name": "iot-bridge",
      "interfaces": ["eth5"],
      "stp": "off",
      "forward_delay": "15",
      "max_age": "20",
      "hello_time": "2",
      "enabled": true
    }
  ]
}
