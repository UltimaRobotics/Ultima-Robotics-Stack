{
  "description": "Add sample configurations and then list all of them",
  "network": {
    "connection_mode": "static",
    "static_ip": "192.168.1.100",
    "subnet_mask": "255.255.255.0",
    "gateway": "192.168.1.1",
    "dns_servers": ["8.8.8.8", "1.1.1.1"],
    "mtu_size": 1500
  },
  "static_routes": [
    {
      "operation": "add",
      "target": "10.0.0.0/8",
      "gateway": "192.168.1.1",
      "interface": "br-lan",
      "metric": 10,
      "enabled": true
    },
    {
      "operation": "add",
      "target": "172.16.0.0/12",
      "gateway": "192.168.1.1",
      "interface": "br-lan",
      "metric": 20,
      "enabled": true
    }
  ],
  "vlans": [
    {
      "operation": "add",
      "name": "test-vlan",
      "vlan_id": 100,
      "base_interface": "eth0",
      "protocol": "802.1q",
      "enabled": true
    }
  ],
  "firewall_rules": [
    {
      "operation": "add",
      "name": "test-rule",
      "type": "rule",
      "src": "wan",
      "dest": "lan",
      "target": "ACCEPT",
      "proto": "tcp",
      "src_port": "22",
      "enabled": true
    }
  ],
  "bridges": [
    {
      "operation": "add",
      "name": "test-bridge",
      "interfaces": ["eth0", "eth1"],
      "stp": "on",
      "forward_delay": "15",
      "max_age": "20",
      "hello_time": "2",
      "enabled": true
    }
  ],
  "nat_rules": [
    {
      "operation": "add",
      "name": "test-nat",
      "type": "nat",
      "src": "lan",
      "dest": "wan",
      "target": "MASQUERADE",
      "proto": "",
      "enabled": true
    }
  ],
  "listing": {
    "show_status": true,
    "show_interface_info": true,
    "list_static_routes": true,
    "list_vlans": true,
    "list_firewall_rules": true,
    "list_bridges": true,
    "list_nat_rules": true
  }
}
