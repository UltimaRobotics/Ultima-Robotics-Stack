{
  "client_id": "ur-mavcollector",
  "broker_host": "127.0.0.1",
  "broker_port": 1899,
  "keepalive": 30,
  "qos": 0,
  "auto_reconnect": true,
  "reconnect_delay_min": 1,
  "reconnect_delay_max": 60,
  "use_tls": false,
  "heartbeat": {
    "enabled": true,
    "interval_seconds": 1,
    "topic": "clients/ur-mavcollector/heartbeat",
    "payload": "{\"client\":\"ur-mavcollector\",\"status\":\"alive\"}"
  },
  "json_added_pubs": {
    "topics": [
      "direct_messaging/ur-mavcollector/responses",
      "direct_messaging/ur-mavdiscovery/requests",
      "ur-shared-bus/ur-mavlink-stack/ur-mavcollector/device-info"
    ]
  },
  "json_added_subs": {
    "topics": [
      "direct_messaging/ur-mavcollector/requests",
      "clients/ur-mavdiscovery/heartbeat",
      "direct_messaging/ur-mavdiscovery/responses"
    ]
  }
}
